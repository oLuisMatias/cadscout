<?xml version="1.0" encoding="utf-8"?>
<!--
  Package description of CADscout Lite for the Microsoft Store (MSIX). build_msix.bat copies this file next to the program
  files and replaces @VERSION@ (x.y.z.0, taken from vcpkg.json).

  Identity Name, Publisher and PublisherDisplayName are the "Product identity" values of the app in Partner Center; they must
  match them exactly or the Store rejects the package.
-->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
         xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
         xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
         xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap3 desktop4 desktop5 com rescap">

  <Identity Name="LuissApps.CADscoutLite" Publisher="CN=8D1AC23B-6C40-475C-903A-77AE0F2503F1" Version="@VERSION@" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>CADscout Lite</DisplayName>
    <PublisherDisplayName>Luis's Apps</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
    <!-- The C++ runtime is not bundled: the Store installs it from this package. -->
    <PackageDependency Name="Microsoft.VCLibs.140.00.UWPDesktop" MinVersion="14.0.30035.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="CADscoutLite" Executable="CADscoutLite.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="CADscout Lite"
                          Description="Small viewer for CAD and 3D print files."
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- Model files: CADscout Lite appears in "Open with" and can be chosen as the default program. The program
             receives the file path as its first argument. -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="cadscoutmodels">
            <uap:DisplayName>3D model</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.stp</uap:FileType>
              <uap:FileType>.step</uap:FileType>
              <uap:FileType>.igs</uap:FileType>
              <uap:FileType>.iges</uap:FileType>
              <uap:FileType>.brep</uap:FileType>
              <uap:FileType>.stl</uap:FileType>
              <uap:FileType>.obj</uap:FileType>
              <uap:FileType>.ply</uap:FileType>
              <uap:FileType>.wrl</uap:FileType>
              <uap:FileType>.vrml</uap:FileType>
              <uap:FileType>.gltf</uap:FileType>
              <uap:FileType>.glb</uap:FileType>
              <uap:FileType>.3mf</uap:FileType>
              <uap:FileType>.dxf</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>

        <!-- Right-click entry "View with CADscout" with the program icon, for every model file whatever its default
             program is (declared for all files, the DLL hides it for other types; a fixed entry: it exists while the app is installed). It is implemented by CADscoutLiteMenu.dll
             (src/contextmenu); the Clsid must match CLSID_ViewWithCadscout there. -->
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*"><desktop5:Verb Id="ViewWithCADscout" Clsid="615599F7-62BB-47E5-8FB5-81CF4C0B1DA8" /></desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="CADscout Lite right-click entry">
              <com:Class Id="615599F7-62BB-47E5-8FB5-81CF4C0B1DA8" Path="CADscoutLiteMenu.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
