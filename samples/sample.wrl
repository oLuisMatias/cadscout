#VRML V2.0 utf8
# Small house made of 3 separate named shapes (Base, Tower, Roof) for CADscout.
DEF Base Shape {
  appearance Appearance { material Material { diffuseColor 1.0 0.55 0.1 } }
  geometry IndexedFaceSet {
    coord Coordinate { point [ 0 0 0, 40 0 0, 40 40 0, 0 40 0, 0 0 10, 40 0 10, 40 40 10, 0 40 10 ] }
    coordIndex [ 0 3 2 1 -1, 4 5 6 7 -1, 0 1 5 4 -1, 2 3 7 6 -1, 0 4 7 3 -1, 1 2 6 5 -1 ]
  }
}
DEF Tower Shape {
  appearance Appearance { material Material { diffuseColor 0.2 0.7 0.3 } }
  geometry IndexedFaceSet {
    coord Coordinate { point [ 15 15 10, 25 15 10, 25 25 10, 15 25 10, 15 15 40, 25 15 40, 25 25 40, 15 25 40 ] }
    coordIndex [ 0 3 2 1 -1, 4 5 6 7 -1, 0 1 5 4 -1, 2 3 7 6 -1, 0 4 7 3 -1, 1 2 6 5 -1 ]
  }
}
DEF Roof Shape {
  appearance Appearance { material Material { diffuseColor 0.2 0.4 0.9 } }
  geometry IndexedFaceSet {
    coord Coordinate { point [ 12 12 40, 28 12 40, 28 28 40, 12 28 40, 20 20 52 ] }
    coordIndex [ 0 3 2 1 -1, 0 1 4 -1, 1 2 4 -1, 2 3 4 -1, 3 0 4 -1 ]
  }
}
